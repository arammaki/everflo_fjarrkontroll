{
  // Admin UI for the EverFlo monitor. Reads what the ingest Worker wrote.
  //
  //   npx wrangler deploy
  //
  // No secrets on this Worker: Cloudflare Access guards it, enabled on the
  // Worker itself (Settings -> Domains & Routes) with a "Cloudflare
  // account" policy, so only members of this account get through. Access
  // works on workers.dev since 2026-08-14; no custom domain needed.
  //
  // Separate from the ingest Worker on purpose. Ingest must never require
  // an interactive login, because an ESP32 cannot do one; admin must
  // always require one. Keeping them apart makes that impossible to
  // confuse — and it is why Access must never be enabled on the ingest
  // Worker, which would break the device silently.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everflo-admin",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "account_id": "86c73d2432665552e5dcab672f0644b3",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everflo",
      "database_id": "5597a503-8219-4d30-906e-22bc7534d735"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "everflo-images",
      "jurisdiction": "eu"
    }
  ]
}
