/* ============================================================
   Copy this file to secrets.h and fill in the real values.
   secrets.h is gitignored and must never be committed.

   The sketch compiles without secrets.h — every feature that needs a
   value here is disabled when the value is empty, so the firmware still
   builds and runs on a machine that does not have the file.

   Note the limit of this approach: these end up in the firmware image and
   can be read out with esptool by anyone holding the device. Acceptable
   for the health ping URL and for a write-only ingest token that can be
   rotated in one command — think again before putting anything stronger
   here.
   ============================================================ */

#pragma once

// --- Health ping ------------------------------------------------------
// healthchecks.io ping URL for the dead man's switch. Empty = disabled,
// and the TLS stack is then dropped by the linker (~119 kB of flash).
//
// Recommended settings on their side: period 5 min, grace 15 min, which
// alerts 20 minutes after the last successful ping.
#define HEALTHCHECK_URL "https://hc-ping.com/00000000-0000-0000-0000-000000000000"

// --- Cloud ingest -----------------------------------------------------
// The Worker in cloud/ — see its wrangler.jsonc. The token is a Worker
// secret set with:
//
//   printf '%s' 'THE-TOKEN' | npx wrangler secret put INGEST_TOKEN
//
// (printf, not echo: wrangler does not trim stdin, and a trailing newline
// makes every request fail with 403 while everything looks correct.)
#define INGEST_URL   "https://everflo-ingest.example.workers.dev/ingest"
#define INGEST_TOKEN "replace-me"
